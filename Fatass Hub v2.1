    if infStaminaActivo then
        task.wait(0.3)
        escanear(ch)
    end
end)

LocalPlayer.DescendantAdded:Connect(function(obj)
    if infStaminaActivo then
        if esStamNodo(obj) or esCanSprintNodo(obj) then
