local function contarScripts(modelo)
    if not modelo or not modelo:IsA("Model") then return 0 end
    local count = 0
    for _, hijo in ipairs(modelo:GetDescendants()) do
        if hijo:IsA("Script") or hijo:IsA("LocalScript") or hijo:IsA("ModuleScript") then
            count = count + 1
        end
    end
    return count
end

local function encontrarKillerAutomatico()
    local mejorKiller, mejorRazon = nil, nil
    local mejorScore = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ch = p.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local numScripts = contarScripts(ch)
                local altura = ch:GetExtentsSize().Y
                if numScripts >= KILLER_SCRIPTS_THRESHOLD then
                    local score = 1000 + numScripts
                    if score > mejorScore then
                        mejorScore = score; mejorKiller = ch
                        mejorRazon = "scripts (" .. numScripts .. ")"
                    end
                elseif altura > mejorScore then
                    mejorScore = altura; mejorKiller = ch
                    mejorRazon = "tall (" .. string.format("%.1f", altura) .. ")"
                end
            end
        end
    end
    return mejorKiller, mejorRazon
end

local function estaApuntando()
    local miChar = LocalPlayer.Character
    if not miChar then return false end
    return miChar:GetAttribute("IsAiming") == true
end

local function getTargetChest(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function getPredictChestPos(char)
    if not char then return nil end
    local chest = getTargetChest(char)
    if not chest then return nil end
    local velocity = Vector3.new(0, 0, 0)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        velocity = hrp.AssemblyLinearVelocity
        if velocity.Magnitude < 0.1 then
            velocity = hrp.Velocity
        end
    end
    local predict = velocity * 0.12
    if predict.Magnitude > PREDICT_STUDS then
        predict = predict.Unit * PREDICT_STUDS
    end
    return chest.Position + predict
end

local function iniciarAimlock()
    if cameraConnection then return end
    cameraConnection = RunService.RenderStepped:Connect(function()
        if not aimlockOnAim then return end
        if not estaApuntando() then return end
        if not characterTarget or not characterTarget.Parent then
            characterTarget = encontrarKillerAutomatico()
        end
        if characterTarget and characterTarget.Parent then
            local aimPos = getPredictChestPos(characterTarget)
            if aimPos and typeof(aimPos) == "Vector3" then
                local cam = workspace.CurrentCamera
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimPos)
            end
        end
    end)
end

local function detenerAimlock()
    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end
    characterTarget = nil
end

