local function quitarJ(modelo)
    local d = playersESP[modelo]; if not d then return end
    pcall(function()
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
    end)
    playersESP[modelo] = nil
end

local function limpiarTodosESPPlayers()
    for m in pairs(playersESP) do quitarJ(m) end
    playersESP = {}
end

local function escanearPlayers()
    local encontrados = {}
    local listaChars = {}
    local masAlto = nil
    local alturaMax = -math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ch = p.Character
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum then
                table.insert(listaChars, ch)
                local ok, tam = pcall(function() return ch:GetExtentsSize().Y end)
                if ok and tam and tam > alturaMax then
                    alturaMax = tam
                    masAlto = ch
                end
            end
        end
    end

    for _, ch in ipairs(listaChars) do
        crearJ(ch, ch == masAlto)
        encontrados[ch] = true
    end

    for m in pairs(playersESP) do
        if not encontrados[m] or not m.Parent then quitarJ(m) end
    end
end

