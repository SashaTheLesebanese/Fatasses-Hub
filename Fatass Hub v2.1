local playersESP = {}
local COLOR_VERDE     = Color3.fromRGB(0, 255, 0)
local COLOR_VERDE_OUT = Color3.fromRGB(90, 255, 90)
local COLOR_ROJO      = Color3.fromRGB(255, 0, 0)
local COLOR_ROJO_OUT  = Color3.fromRGB(255, 70, 70)

local function aplicarColorJ(entry, esRojo)
    if not entry or not entry.hl then return end
    if esRojo then
        entry.hl.FillColor    = COLOR_ROJO
        entry.hl.OutlineColor = COLOR_ROJO_OUT
    else
        entry.hl.FillColor    = COLOR_VERDE
        entry.hl.OutlineColor = COLOR_VERDE_OUT
    end
end

local function crearJ(modelo, esRojo)
    if not modelo then return end
    if playersESP[modelo] then
        aplicarColorJ(playersESP[modelo], esRojo)
        return
    end
    local hl = Instance.new("Highlight")
    hl.Name = "ESP_P_HL"
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = modelo
    hl.Parent = modelo
    aplicarColorJ({hl = hl}, esRojo)

    local bg = Instance.new("BillboardGui")
    bg.Name = "ESP_P_BB"; bg.Size = UDim2.new(0, 160, 0, 60)
    bg.StudsOffset = Vector3.new(0, 3.5, 0); bg.AlwaysOnTop = true; bg.Parent = modelo

    local n = Instance.new("TextLabel")
