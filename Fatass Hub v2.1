local function reproducirSonido(nombre, vol, pitch)
    local id = SONIDOS[nombre]; if not id then return end
    local sound = Instance.new("Sound")
    sound.SoundId = id; sound.Volume = vol or VOLUMENES[nombre] or 0.5
    sound.PlaybackSpeed = pitch or 1; sound.Parent = SoundService
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
    task.delay(3, function() if sound and sound.Parent then sound:Destroy() end end)
end

