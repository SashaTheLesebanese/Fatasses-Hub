-- AUTO SHOOT (disparo instantáneo)
-- ============================================
local TIEMPO_AIM_ANTES_DISPARO = 0
local COOLDOWN_DISPARO = 0.6

local function buscarTriggerButton()
    local gui = LocalPlayer.PlayerGui:FindFirstChild("GunGui")
    if not gui then return nil end
    return gui:FindFirstChild("TriggerButton", true)
        or gui:FindFirstChild("Trigger", true)
        or gui:FindFirstChild("ShootButton", true)
end

local function tieneLineaDeVision(killer)
    if not killer then return false end
    local miChar = LocalPlayer.Character
    if not miChar then return false end
    local miHead = miChar:FindFirstChild("Head") or miChar:FindFirstChild("HumanoidRootPart")
    local kChest = killer:FindFirstChild("UpperTorso")
        or killer:FindFirstChild("Torso")
        or killer:FindFirstChild("HumanoidRootPart")
        or killer:FindFirstChild("Head")
    if not miHead or not kChest then return false end

    local origin = miHead.Position
    local dir = kChest.Position - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {miChar, killer}
    params.IgnoreWater = true

    local result = Workspace:Raycast(origin, dir, params)
    return result == nil
end

local function dispararTrigger()
    local btn = buscarTriggerButton()
    if not btn then return false end
    if firesignal then
        pcall(firesignal, btn.MouseButton1Click)
        return true
    end
    pcall(function() btn:Activate() end)
    return false
end

local autoShootConn = nil

function iniciarAutoShoot()
    if autoShootConn then return end
    aimStartTime = 0
    autoShootConn = RunService.RenderStepped:Connect(function()
        if not autoShootActivo then return end

        local miChar = LocalPlayer.Character
        if not miChar then aimStartTime = 0; return end

        local apuntando = miChar:GetAttribute("IsAiming") == true
        if not apuntando then
            aimStartTime = 0
            return
        end

        if aimStartTime == 0 then
            aimStartTime = tick()
            return
        end

        if tick() - aimStartTime < TIEMPO_AIM_ANTES_DISPARO then return end
        if tick() - ultimoDisparo < COOLDOWN_DISPARO then return end

        local killer = characterTarget
        if not killer or not killer.Parent then
            killer = encontrarKillerAutomatico()
        end
        if not killer or not killer.Parent then return end

        if tieneLineaDeVision(killer) then
            local ok = dispararTrigger()
            if ok then
                ultimoDisparo = tick()
                aimStartTime = tick()
            end
        end
    end)
end

function detenerAutoShoot()
    if autoShootConn then autoShootConn:Disconnect(); autoShootConn = nil end
    aimStartTime = 0
end
