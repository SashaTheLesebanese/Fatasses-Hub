local brokenScientistThread = nil

-- Rompe TaskGuiMap2 (los tubos / pipes)
local function romperPipes()
    local pg = LocalPlayer.PlayerGui
    local taskGui = pg:FindFirstChild("TaskGuiMap2")
    if not taskGui then return end

    local gridContainer = taskGui:FindFirstChild("GridContainer")
    if not gridContainer then return end

    for _, cell in ipairs(gridContainer:GetChildren()) do
        if cell:IsA("Frame") then
            -- Marcar como roto
            local ib = cell:FindFirstChild("IsBroken")
            if not ib then
                ib = Instance.new("BoolValue")
                ib.Name = "IsBroken"
                ib.Parent = cell
            end
            ib.Value = true

            -- Agregar overlay rojo
            local ov = cell:FindFirstChild("BrokenOverlay")
            if not ov then
                local img = cell:FindFirstChildOfClass("ImageButton")
                if img then
                    ov = Instance.new("ImageLabel")
                    ov.Name = "BrokenOverlay"
                    ov.Size = UDim2.new(1, 0, 1, 0)
                    ov.BackgroundTransparency = 1
                    ov.Image = "rbxassetid://75488477983400"
                    ov.ImageColor3 = Color3.fromRGB(255, 60, 60)
                    ov.ImageTransparency = 0.3
                    ov.ZIndex = 5
                    ov.Parent = cell
                end
            end

            -- Cambiar color a rojo
            local img = cell:FindFirstChildOfClass("ImageButton")
            if img then
                pcall(function() img.ImageColor3 = Color3.fromRGB(255, 60, 60) end)
            end
        end
    end
end

-- Rompe TaskGuiMap1 (el minijuego de notas / ritmo)
local function romperNotes()
    local pg = LocalPlayer.PlayerGui
    local taskGui = pg:FindFirstChild("TaskGuiMap1")
    if not taskGui then return end

    local fm = taskGui:FindFirstChild("Frame")
    if not fm then return end

    -- Eliminar todas las notas constantemente
    for _, h in ipairs(fm:GetChildren()) do
        if h.Name == "Note" and h:IsA("Frame") then
            pcall(function() h:Destroy() end)
        end
    end

    -- Poner el contador en 0/15
    local counter = fm:FindFirstChild("Counter")
    if counter and counter:IsA("TextLabel") then
        pcall(function() counter.Text = "0/15" end)
    end

    -- Poner los misses al máximo
    local misses = fm:FindFirstChild("Misses")
    if misses and misses:IsA("TextLabel") then
        pcall(function() misses.Text = "Misses: 99/99" end)
    end

    -- Ocultar el Catcher
    local catcher = fm:FindFirstChild("Catcher")
    if catcher then
        pcall(function()
            catcher.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            catcher.BackgroundTransparency = 0.5
        end)
    end

    -- Fire Miss al TaskRemote para forzar el fallo
    local taskRemote = ReplicatedStorage:FindFirstChild("TaskRemote")
    if taskRemote and taskRemote:IsA("RemoteEvent") then
        pcall(function() taskRemote:FireServer("Miss") end)
        pcall(function() taskRemote:FireServer("LeaveTask") end)
        pcall(function() taskRemote:FireServer("Failure") end)
    end
end

-- Rompe también el objeto del workspace
local function romperWorkspaceObjs()
    for _, obj in ipairs(Workspace:GetChildren()) do
        local n = obj.Name
        if string.find(n, "Task_") or string.find(n, "TaskGui") then
            -- No destruir, solo marcar
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                pcall(function() prompt.Enabled = false end)
            end
        end
    end
end

function iniciarBrokenScientist()
    brokenScientistActivo = true
    if brokenScientistThread then return end
    brokenScientistThread = task.spawn(function()
        while brokenScientistActivo do
            task.wait(0.15)
            if not brokenScientistActivo then break end
            pcall(romperPipes)
            pcall(romperNotes)
            pcall(romperWorkspaceObjs)
        end
        brokenScientistThread = nil
    end)
end
function detenerBrokenScientist()
    brokenScientistActivo = false
end

