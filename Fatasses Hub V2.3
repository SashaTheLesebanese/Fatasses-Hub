toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragT = true; movedT = false; dsT = input.Position; spT = toggleHolder.Position
    end
end)
toggleBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragT = false
        task.delay(0.1, function() movedT = false end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragT and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dsT
        if delta.Magnitude > 6 then movedT = true end
        toggleHolder.Position = UDim2.new(spT.X.Scale, spT.X.Offset + delta.X, spT.Y.Scale, spT.Y.Offset + delta.Y)
    end
end)

