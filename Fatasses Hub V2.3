-- INF STAMINA
local STAMINA_VALORES_DETECTAR = {100, 175, 200, 225}
local STAMINA_NUEVO = 10000
local infStaminaConn = nil
local ultimoScan = 0
local INTERVALO_SCAN = 0.3
local function esStamNodo(obj)
    if not obj or not obj:IsA("ValueBase") then return false end
    local n = string.lower(obj.Name)
    return n == "stam" or string.find(n, "stamina", 1, true) ~= nil
end
local function esCanSprintNodo(obj)
    if not obj or not obj:IsA("BoolValue") then return false end
    return string.find(string.lower(obj.Name), "cansprint", 1, true) ~= nil
end
local function esValorObjetivo(v)
    for _, t in ipairs(STAMINA_VALORES_DETECTAR) do
        if math.abs(v - t) < 1 then return true end
    end
    return false
end
local function procesarStam(obj)
    if not obj or not obj.Parent then return end
    if esStamNodo(obj) then
        if obj:IsA("IntValue") or obj:IsA("NumberValue") then
            pcall(function()
                local v = obj.Value
                if esValorObjetivo(v) or v < STAMINA_NUEVO then obj.Value = STAMINA_NUEVO end
            end)
        end
    elseif esCanSprintNodo(obj) then
        pcall(function() obj.Value = true end)
    end
end
local function escanearStam(cont)
    if not cont then return end
    for _, obj in ipairs(cont:GetDescendants()) do
        if esStamNodo(obj) or esCanSprintNodo(obj) then procesarStam(obj) end
    end
end
function iniciarInfStamina()
    if infStaminaConn then return end
    ultimoScan = 0
    escanearStam(LocalPlayer.Character)
    escanearStam(LocalPlayer.PlayerGui)
    infStaminaConn = RunService.Heartbeat:Connect(function()
        if not infStaminaActivo then return end
        local ahora = tick()
        if ahora - ultimoScan < INTERVALO_SCAN then return end
        ultimoScan = ahora
        escanearStam(LocalPlayer.Character)
        escanearStam(LocalPlayer.PlayerGui)
    end)
end
function detenerInfStamina()
    if infStaminaConn then infStaminaConn:Disconnect(); infStaminaConn = nil end
end
LocalPlayer.CharacterAdded:Connect(function(ch)
    if infStaminaActivo then task.wait(0.3); escanearStam(ch) end
end)
LocalPlayer.DescendantAdded:Connect(function(obj)
    if infStaminaActivo and (esStamNodo(obj) or esCanSprintNodo(obj)) then procesarStam(obj) end
end)

