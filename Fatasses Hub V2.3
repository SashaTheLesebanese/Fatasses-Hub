    local s = Instance.new("UIStroke"); s.Color = C.border; s.Thickness = 1; s.Transparency = 0.5; s.Parent = tab
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 4, 0, 0); indicator.Position = UDim2.new(0, 0, 0.5, 0)
    indicator.AnchorPoint = Vector2.new(0, 0.5); indicator.BackgroundColor3 = C.accent
    indicator.BorderSizePixel = 0; indicator.Parent = tab
    local indCorner = Instance.new("UICorner"); indCorner.CornerRadius = UDim.new(1, 0); indCorner.Parent = indicator
    local iconMap = {Esp="👁", Scientist="🧪", ["Class A"]="🔒", ["Class S"]="🎯", Experiment="🔒", ["Extra Stuff"]="⚡", Fun="🎉"}
    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 22, 0, 22); icon.Position = UDim2.new(0, 10, 0.5, -11)
    icon.BackgroundTransparency = 1; icon.Text = iconMap[nombre] or "•"
    icon.TextColor3 = comingSoon and C.text_sub or C.text; icon.TextScaled = true
    icon.Font = Enum.Font.GothamBold; icon.Parent = tab
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -46, 1, 0); lbl.Position = UDim2.new(0, 40, 0, 0)
    lbl.BackgroundTransparency = 1; lbl.Text = nombre
    lbl.TextColor3 = comingSoon and C.text_sub or C.text; lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd; lbl.Parent = tab
    if comingSoon then
        local lock = Instance.new("TextLabel")
        lock.Size = UDim2.new(0, 12, 0, 12); lock.Position = UDim2.new(1, -18, 0, 6)
        lock.BackgroundTransparency = 1; lock.Text = "🔒"; lock.TextColor3 = C.text_sub; lock.TextScaled = true; lock.Parent = tab
    end
    local clickeando = false
    local function setState(state)
        if state == "hover" and pestanaActual ~= nombre then
            TweenService:Create(tab, EASE_SOFT, { BackgroundColor3 = C.bg_card_hl, BackgroundTransparency = 0 }):Play()
            TweenService:Create(s, EASE_SOFT, { Color = C.border_hl, Transparency = 0.3, Thickness = 2 }):Play()
            TweenService:Create(icon, EASE_BOUNCE, { Rotation = 15, Size = UDim2.new(0, 26, 0, 26) }):Play()
        elseif state == "leave" and pestanaActual ~= nombre then
            TweenService:Create(tab, EASE_SOFT, { BackgroundColor3 = C.bg_card, BackgroundTransparency = 0.2 }):Play()
            TweenService:Create(s, EASE_SOFT, { Color = C.border, Transparency = 0.5, Thickness = 1 }):Play()
            TweenService:Create(icon, EASE_BOUNCE, { Rotation = 0, Size = UDim2.new(0, 22, 0, 22) }):Play()
        elseif state == "selected" then
            TweenService:Create(tab, EASE_SMOOTH, { BackgroundColor3 = C.bg_card_hl, BackgroundTransparency = 0 }):Play()
            TweenService:Create(s, EASE_SMOOTH, { Color = C.accent2, Transparency = 0.2, Thickness = 2 }):Play()
            TweenService:Create(indicator, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 4, 0.7, 0) }):Play()
            TweenService:Create(icon, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 360, Size = UDim2.new(0, 24, 0, 24) }):Play()
        elseif state == "deselected" then
            TweenService:Create(tab, EASE_SMOOTH, { BackgroundColor3 = C.bg_card, BackgroundTransparency = 0.2 }):Play()
            TweenService:Create(s, EASE_SMOOTH, { Color = C.border, Transparency = 0.5, Thickness = 1 }):Play()
            TweenService:Create(indicator, EASE_SOFT, { Size = UDim2.new(0, 4, 0, 0) }):Play()
        end
    end
    tab.MouseEnter:Connect(function() setState("hover"); reproducirSonido("hover", 0.5, 1.2) end)
    tab.MouseLeave:Connect(function() setState("leave") end)
    tab.MouseButton1Click:Connect(function()
        if clickeando then return end
        if comingSoon then return end
        if pestanaActual == nombre then return end
        clickeando = true
        reproducirSonido("tab_switch", 2.0, 1)
        if tabsRefs[pestanaActual] then tabsRefs[pestanaActual].SetState("deselected") end
        pestanaActual = nombre
        setState("selected")
        task.spawn(function() pcall(actualizarPanel) end)
        task.delay(0.5, function() clickeando = false end)
    end)
    tabsRefs[nombre] = {Button = tab, SetState = setState, ComingSoon = comingSoon, Indicator = indicator}
end

