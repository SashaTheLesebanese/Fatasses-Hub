            crearOpcion("Scream", function(v) if v then iniciarScreamSpam() else detenerScreamSpam() end end)
            crearOpcion("Leeking Heat", function(v) if v then iniciarLeekingHeatSpam() else detenerLeekingHeatSpam() end end)
            crearOpcion("Broken Scientist minigame", function(v) if v then iniciarBrokenScientist() else detenerBrokenScientist() end end)
            crearBotonGenerar("Generate Scream button", Color3.fromRGB(180,90,255), intentarScream)
            crearBotonGenerar("Generate Leeking heat button", Color3.fromRGB(80,255,120), intentarLeekingHeat)
        end

        task.wait(0.05)
        for _, hijo in ipairs(opcionesContainer:GetChildren()) do
            if hijo:IsA("Frame") and miPanelId == panelIdActual then
                local origPos = hijo.Position
                hijo.Position = origPos + UDim2.new(0.25, 0, 0, 0)
                hijo.BackgroundTransparency = 1
                TweenService:Create(hijo, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = origPos, BackgroundTransparency = 0.2 }):Play()
                task.wait(0.06)
            end
        end
        task.wait(0.5)
    end)
    if not ok then warn("[Fatasses] Error en actualizarPanel: " .. tostring(err)) end
    actualizandoPanel = false
end

