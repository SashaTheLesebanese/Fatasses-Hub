-- CÁMARA LOCK
local camLockTarget = nil
local camLockEnd = 0
RunService.RenderStepped:Connect(function()
    if camLockTarget then
        if not camLockTarget.Parent or tick() >= camLockEnd then camLockTarget = nil; return end
        local chest = camLockTarget:FindFirstChild("UpperTorso") or camLockTarget:FindFirstChild("Torso") or camLockTarget:FindFirstChild("HumanoidRootPart")
        if chest then
            local cam = workspace.CurrentCamera
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, chest.Position)
        end
    end
end)
local function iniciarCamLock(target, duracion)
    if not target or not target.Parent then return end
    camLockTarget = target
    camLockEnd = tick() + duracion
end

local function tieneLineaDeVision(objetivo)
    if not objetivo then return false end
    local miChar = LocalPlayer.Character
    if not miChar then return false end
    local miHead = miChar:FindFirstChild("Head") or miChar:FindFirstChild("HumanoidRootPart")
    local tHead = objetivo:FindFirstChild("Head") or objetivo:FindFirstChild("HumanoidRootPart")
    if not miHead or not tHead then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {miChar, objetivo}
    local r = Workspace:Raycast(miHead.Position, tHead.Position - miHead.Position, params)
    return r == nil
end

-- EVENTOS
local function buscarEventoGlobal(nombre)
    local e = ReplicatedStorage:FindFirstChild(nombre)
    if e and e:IsA("RemoteEvent") then return e end
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name == nombre then return v end
    end
    for _, v in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name == nombre then return v end
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name == nombre then return v end
    end
    return nil
end

local SCREAM_EVENT_CACHE = nil
local LEEKING_EVENT_CACHE = nil

local function getScreamEvent()
    if SCREAM_EVENT_CACHE and SCREAM_EVENT_CACHE.Parent then return SCREAM_EVENT_CACHE end
    local gui = LocalPlayer.PlayerGui:FindFirstChild("RageScreech")
    if gui then
        for _, v in ipairs(gui:GetDescendants()) do
            if v:IsA("RemoteEvent") then SCREAM_EVENT_CACHE = v; return v end
        end
    end
    SCREAM_EVENT_CACHE = buscarEventoGlobal("AbilityEvent2") or buscarEventoGlobal("RageScreechEvent")
    return SCREAM_EVENT_CACHE
end

local function getLeekingEvent()
    if LEEKING_EVENT_CACHE and LEEKING_EVENT_CACHE.Parent then return LEEKING_EVENT_CACHE end
    local gui = LocalPlayer.PlayerGui:FindFirstChild("LeekingHeat")
    if gui then
        for _, v in ipairs(gui:GetDescendants()) do
            if v:IsA("RemoteEvent") then LEEKING_EVENT_CACHE = v; return v end
        end
    end
    LEEKING_EVENT_CACHE = buscarEventoGlobal("LeekingHeatEvent") or buscarEventoGlobal("AbilityEvent")
    return LEEKING_EVENT_CACHE
end

-- RESET / TRIGGER
local function resetStun()
    local ch = LocalPlayer.Character
    if not ch then return end
    for _, n in ipairs({"Stun","UsingPrimaryStrategy","UsingSecondaryStrategy"}) do
        local v = ch:FindFirstChild(n)
        if v and v:IsA("ValueBase") then pcall(function() v.Value = false end) end
    end
end

local function resetCooldownLabel(guiName)
    local gui = LocalPlayer.PlayerGui:FindFirstChild(guiName)
    if not gui then return end
    local cd = gui:FindFirstChild("CooldownLabel", true)
    if cd and cd:IsA("TextLabel") then
        pcall(function()
            cd.Text = "0"
            if cd:GetAttribute("Active") then cd:SetAttribute("Active", false) end
        end)
    end
end

local function buscarBoton(guiName)
    local pg = LocalPlayer.PlayerGui
    local gui = pg:FindFirstChild(guiName)
    if not gui then return nil end
    return gui:FindFirstChild("Ability1") or gui:FindFirstChildWhichIsA("GuiButton", true)
end

local function triggerAbility(guiName, ev)
    resetStun()
    resetCooldownLabel(guiName)
    local btn = buscarBoton(guiName)
    if btn and firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
    end
    if btn and VirtualUser and btn.AbsoluteSize.Magnitude > 0 then
        pcall(function()
            VirtualUser:CaptureController()
            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            VirtualUser:ClickButton1(Vector3.new(pos.X, pos.Y, 0))
        end)
    end
    if btn then pcall(function() btn:Activate() end) end
    if ev then pcall(function() ev:FireServer() end) end
    return true
end

local function intentarScream()
    return triggerAbility("RageScreech", getScreamEvent())
end

local function intentarLeekingHeat()
    return triggerAbility("LeekingHeat", getLeekingEvent())
end

